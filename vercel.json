{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    { "src": "apps/web/package.json", "use": "@vercel/next" },
    { "src": "api/**/*.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "apps/web/$1" }
  ]
}